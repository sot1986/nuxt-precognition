{
  "name": "nuxt-precognition",
  "type": "module",
  "version": "0.3.2",
  "description": "Nuxt module implementing Precognition protocol (inspired by official Laravel Precognition) for backend precognitive validation.",
  "author": {
    "name": "sot1986",
    "email": "sot@8dplus.com"
  },
  "license": "MIT",
  "homepage": "https://precognition.presot-studio.it",
  "repository": {
    "type": "git",
    "url": "https://github.com/sot1986/nuxt-precognition"
  },
  "keywords": [
    "precognition",
    "nuxt",
    "laravel",
    "zod",
    "appsync",
    "validation"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest watch",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4",
    "defu": "^6.1.7",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/eslint-config": "^0.3.13",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^3.23.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@tailwindcss/forms": "^0.5.11",
    "@types/lodash": "^4.17.27",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "autoprefixer": "^10.7.0",
    "changelogen": "^0.5.7",
    "eslint": "^8.57.1",
    "h3": "^1.15.11",
    "nuxt": "^4.6.4",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "vue": "^3.5.46",
    "vue-tsc": "^2.2.12",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.21.0"
}
